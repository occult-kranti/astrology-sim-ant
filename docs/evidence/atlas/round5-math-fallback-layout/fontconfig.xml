<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
 <dir>/usr/share/fonts/truetype/dejavu</dir>
 <dir>/usr/share/fonts/truetype/liberation</dir>
 <dir>/usr/share/fonts/truetype/liberation2</dir>
 <cachedir>/tmp/atlas-ci-font-cache</cachedir>
 <alias><family>system-ui</family><prefer><family>DejaVu Sans</family></prefer></alias>
 <alias><family>sans-serif</family><prefer><family>DejaVu Sans</family></prefer></alias>
 <alias><family>serif</family><prefer><family>Liberation Serif</family></prefer></alias>
 <alias><family>monospace</family><prefer><family>DejaVu Sans Mono</family></prefer></alias>
</fontconfig>
