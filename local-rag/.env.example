# Environment names only; never put real credentials in Git or browser code.
RAG_PORT=8844
RAG_LOCAL_BASE_URL=http://127.0.0.1:8845/v1/
RAG_LOCAL_MODEL=workbench-qwen3-4b-q4
RAG_LOCAL_ENABLED=1
RAG_TIMEOUT_MS=110000
RAG_MAX_TOKENS=512
RAG_MAX_CONCURRENT=1
RAG_PROMPT_PROFILE=scenario-v3
# Pinned llama.cpp setup checks actual prompt tokens before generation.
# Other local endpoints can set off; health then discloses no tokenizer fit check.
LOCAL_CONTEXT_PREFLIGHT=llama.cpp
LOCAL_CONTEXT_LIMIT=8192
# Comma-separated exact origins, no wildcard or path. Same-origin local app works by default.
RAG_ALLOWED_ORIGINS=
# Optional file:// access. Prefer the companion's localhost URL instead.
RAG_ALLOW_FILE_ORIGIN=0
# Optional paid API path; set both only in the server process environment.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional official SIWC path. Authorization is an explicit browser action.
# Select a model actually offered to the connected account; none is assumed.
CHATGPT_MODEL=
